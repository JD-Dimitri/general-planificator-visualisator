# Valeurs par défaut, versionnées. Les secrets vont dans .env.local (jamais dans git).

###> symfony/framework-bundle ###
APP_ENV=dev
APP_SECRET=change-moi-en-production
TRUSTED_PROXIES=127.0.0.1,REMOTE_ADDR
###< symfony/framework-bundle ###

###> doctrine/doctrine-bundle ###
# Plateforme managée : la variable DATABASE_URL est fournie par l'hébergeur.
DATABASE_URL="postgresql://gpv:gpv@127.0.0.1:5432/gpv?serverVersion=16&charset=utf8"
###< doctrine/doctrine-bundle ###

###> lexik/jwt-authentication-bundle ###
JWT_SECRET_KEY=%kernel.project_dir%/config/jwt/private.pem
JWT_PUBLIC_KEY=%kernel.project_dir%/config/jwt/public.pem
JWT_PASSPHRASE=change-moi-en-production
# Durée de vie du jeton d'accès, en secondes (1 h).
JWT_TTL=3600
###< lexik/jwt-authentication-bundle ###

# Durée de vie du jeton de rafraîchissement, en secondes (30 jours).
REFRESH_TOKEN_TTL=2592000

###> nelmio/cors-bundle ###
CORS_ALLOW_ORIGIN='^https?://(localhost|127\.0\.0\.1)(:[0-9]+)?$'
###< nelmio/cors-bundle ###

###> symfony/mailer ###
# null://null n'envoie rien : parfait en développement.
# En production : smtp://user:pass@smtp.exemple.fr:587, ou le DSN de l'hébergeur.
MAILER_DSN=null://null
MAILER_SENDER="GPV <bonjour@gpv.local>"
###< symfony/mailer ###

###> symfony/notifier ###
# SMS : demande un fournisseur payant (Twilio, OVH, Vonage).
# Laissé vide, GPV bascule automatiquement sur l'e-mail.
# TEXTER_DSN=twilio://SID:TOKEN@default?from=FROM
###< symfony/notifier ###

# Adresse publique du front, pour construire le lien de réinitialisation.
APP_URL=http://localhost:5173

# Rend le code et le lien dans les réponses de l'API, pour essayer le parcours
# sans serveur de mail. À laisser à 0 partout sauf en développement.
EXPOSE_DEV_CODES=1
