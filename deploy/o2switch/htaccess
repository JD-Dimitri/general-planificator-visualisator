# GPV sur hébergement mutualisé (cPanel / o2switch).
# À déposer dans public_html sous le nom .htaccess
#
# Une seule racine sert les deux : /api part vers Symfony, tout le reste vers
# l'application React. La dernière règle est indispensable — sans elle,
# recharger la page sur /domaines/<id> renverrait une erreur 404 d'Apache,
# puisque ce chemin n'existe pas sur le disque.

# Le front d'abord : « / » doit afficher React, pas le contrôleur PHP.
DirectoryIndex index.html

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Forcer HTTPS. À commenter tant que le certificat n'est pas encore émis.
    RewriteCond %{HTTPS} !=on
    RewriteCond %{HTTP:X-Forwarded-Proto} !https
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    # Apache en CGI mange l'en-tête Authorization : sans ceci, les jetons JWT
    # n'arrivent jamais jusqu'à Symfony.
    RewriteCond %{HTTP:Authorization} .+
    RewriteRule ^ - [E=HTTP_AUTHORIZATION:%0]

    # L'API passe par Symfony.
    RewriteCond %{REQUEST_URI} ^/api
    RewriteRule ^ index.php [L]

    # Un fichier qui existe vraiment est servi tel quel.
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Tout le reste est une route de l'application React.
    RewriteRule ^ index.html [L]
</IfModule>

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    # Les fichiers du build portent une empreinte dans leur nom : ils ne
    # changent jamais sous le même nom, donc ils se gardent un an.
    <FilesMatch "\.(js|css|woff2|png|jpg|svg|webp|avif)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
    # index.html, lui, ne doit jamais rester en cache : c'est lui qui pointe
    # vers la dernière version des fichiers.
    <FilesMatch "^index\.html$">
        Header set Cache-Control "no-cache, must-revalidate"
    </FilesMatch>
</IfModule>

# Rien à voir ici.
<FilesMatch "^\.env">
    Require all denied
</FilesMatch>
