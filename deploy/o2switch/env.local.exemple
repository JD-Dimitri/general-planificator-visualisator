# À copier dans ~/gpv/backend/.env.local sur le serveur.
# Ce fichier n'est jamais versionné et n'est pas servi par Apache.

APP_ENV=prod
APP_DEBUG=0

# 32 octets au hasard : php -r "echo bin2hex(random_bytes(16)), PHP_EOL;"
APP_SECRET=REMPLACE_MOI

# Base créée dans cPanel › Bases de données MySQL.
# Le nom et l'utilisateur sont préfixés par ton identifiant cPanel.
DATABASE_URL="mysql://moncpanel_gpv:MOT_DE_PASSE@127.0.0.1:3306/moncpanel_gpv?serverVersion=10.11.0-MariaDB&charset=utf8mb4"

# Clés générées par « php bin/console lexik:jwt:generate-keypair »
JWT_PASSPHRASE=REMPLACE_MOI
JWT_TTL=3600
REFRESH_TOKEN_TTL=2592000

# Boîte créée dans cPanel › Comptes de messagerie.
# Sans un envoi qui fonctionne, personne ne peut se connecter : le code
# à usage unique ne partirait jamais.
MAILER_DSN=smtp://gpv%40mondomaine.fr:MOT_DE_PASSE@mondomaine.fr:587
MAILER_SENDER="GPV <gpv@mondomaine.fr>"

# Adresse publique, utilisée dans le lien de réinitialisation.
APP_URL=https://gpv.mondomaine.fr

# Le front et l'API sont sur le même domaine : rien à ouvrir.
CORS_ALLOW_ORIGIN=^https://gpv\.mondomaine\.fr$

# Jamais 1 en production : à 1, l'API renvoie les codes en clair.
EXPOSE_DEV_CODES=0
